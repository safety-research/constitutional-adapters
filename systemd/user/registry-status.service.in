# registry-status.service — results registry. Rendered for the site and installed into ~/.config/systemd/user/ by the registry installer.
# Secret-free: the registry needs no credential; ssh (when used) goes through the agent socket.
# Bounded: Type=oneshot with TimeoutStartSec, Restart=no (the timer is the only re-fire; an on-failure restart re-ran a failing
# oneshot every RestartSec and kept it `activating` through every paused window, 2026-09-20), and a start-rate limit sized to
# ~2x the healthy cadence, so a persistent failure trips the limit (visible in the journal and on the status page) instead of
# looping. Locks: only the registry's own (<root>/harvester.lock, snapshots/.readers.lock) — never the paper builder's.
[Unit]
Description=Results registry: re-render the status page (the stamp advances even when nothing changed)
# Every 10 min; the ONLY renderer (the harvester no longer passes --html). Renders
# within [status] render_budget_s (120 s): a section over its budget shows its last good rows, marked, and joins the
# cached-with-refresh set registry-status-heavy.timer recomputes.
After=network-online.target
StartLimitIntervalSec=1h
StartLimitBurst=12

[Service]
Type=oneshot
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=6
Environment=PYTHONPATH=@REPO@/src
Environment=REGISTRY_ROOT=@REGISTRY_ROOT@
Environment=PYTHONUNBUFFERED=1
ExecStart=@PYTHON@ -m sisteer.registry.cli status --html
Restart=no
TimeoutStartSec=10min
SyslogIdentifier=registry-status
StandardOutput=journal
StandardError=journal
