# registry-mirrors.timer — results registry. Rendered for the site and installed into ~/.config/systemd/user/ by the registry installer.
# Secret-free (the Modal destination is gone, so no credential is evaluated here); ssh goes through the agent socket.
# Bounded: Type=oneshot with TimeoutStartSec, Restart=no (the timer is the only re-fire; an on-failure restart re-ran a failing
# oneshot every RestartSec and kept it `activating` through every paused window, 2026-09-20), and a start-rate limit sized to
# ~2x the healthy cadence, so a persistent failure trips the limit (visible in the journal and on the status page) instead of
# looping. Locks: only the registry's own (<root>/harvester.lock, snapshots/.readers.lock) — never the paper builder's.
[Unit]
Description=Results registry mirror fan-out, every 5 min

[Timer]
OnBootSec=4min
OnUnitActiveSec=5min
AccuracySec=30s
Unit=registry-mirrors.service

[Install]
WantedBy=timers.target
