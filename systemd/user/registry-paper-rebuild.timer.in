# registry-paper-rebuild.timer — results registry. Rendered for the site and installed into ~/.config/systemd/user/ by the registry installer.
# Secret-free: the registry needs no credential; ssh (when used) goes through the agent socket.
# Bounded: Type=oneshot with TimeoutStartSec, Restart=on-failure with RestartSec, and a start-rate limit sized to ~2x the
# healthy cadence, so a persistent failure trips the limit (visible in the journal and on the status page) instead of
# looping. Locks: only the registry's own (<root>/harvester.lock, snapshots/.readers.lock) — never the paper builder's.
[Unit]
Description=Results registry paper rebuild trigger, every 2 min

[Timer]
OnBootSec=6min
OnUnitActiveSec=2min
AccuracySec=30s
Unit=registry-paper-rebuild.service

[Install]
WantedBy=timers.target
