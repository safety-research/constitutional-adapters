# reproduce/site.example/clusters/cluster_b.env — one Slurm cluster (the overflow cluster). Values are the site's own.
# $SHARED (this block's CLUSTER_SHARED_ROOT, a literal absolute path) is the only `$` a block expands; any other refuses by name.
CLUSTER_SSH=cluster-b-login                  # ssh alias of the login host (BatchMode; keys in your agent — never on the cluster)
CLUSTER_SHARED_ROOT=/data/example/shared  # the per-user shared storage root every compute node mounts ($SHARED)
CLUSTER_PARTITION=gpu
CLUSTER_QOS=normal
CLUSTER_ACCOUNT=''                           # optional --account
CLUSTER_SBATCH_EXTRA=''                      # extra sbatch flags for every job, e.g. "--exclude=<a broken node>"
CLUSTER_DEV_PARTITION=''                     # optional: an interactive/CPU partition for the model fetch (default: CLUSTER_PARTITION)
CLUSTER_DEV_QOS=''
CLUSTER_HF_HOME='$SHARED/hf_cache'           # the HF cache jobs read OFFLINE (hf_fetch.sh fills it); also $HF_HOME in a committed config
CLUSTER_HF_TOKEN_SOURCE=env                  # op | env | none — how hf_fetch.sh obtains a read token (over stdin, never on the cluster)
CLUSTER_REPO_MIRROR='$SHARED/repos/constitutional-adapters'   # the cluster's clone of this repo, which the repo-mirror tool updates
CLUSTER_EVAL_REPO_ROOT='$SHARED/sisteer-eval-repo'   # <root>/<sha> = the clean checkout a wave pins
CLUSTER_PETRI_REPO_ROOT='$SHARED/sisteer-petri-repo' # <root>/<sha> = the clean checkout a Petri drive pins
CLUSTER_PROJECT_ROOT='$SHARED/sisteer'             # the project directory jobs write and read (<root>/out, <root>-<suffix> per experiment)
CLUSTER_HELPERS_DIR='$SHARED/scripts'        # hf_env.sh, mirror-figs.sh, registry/ installed by 00_setup.sh
CLUSTER_ENVS_DIR='$SHARED/envs'
CLUSTER_FIT_ENV_NAME=''                      # the prebuilt fit venv NAME under CLUSTER_ENVS_DIR (sdfbase_fit_env.sbatch <name>); empty -> SISTEER_FIT_ENV_NAME, else sdfbase-fit
CLUSTER_LOG_DIR='$SHARED/exp/logs'
# three names, one job each: the file name and CLUSTER_LABEL are the site label (the front door's loops; extra_json.cluster_label
# on every record); CLUSTER_SUBSTRATE is the registry label (the registry's [[clusters]].name, every --dest, record substrates);
# CLUSTER_MIRROR_SELECTOR is only what the site's repo-mirror tool calls this cluster
CLUSTER_SUBSTRATE=slurm                      # registry label: `slurm` (generic, for any site's cluster) requires CLUSTER_LABEL
CLUSTER_LABEL=cluster_b                      # the site label
CLUSTER_MIRROR_SELECTOR=''                   # empty -> the site label
CLUSTER_HIGH_BUDGET_GPUS=16                  # the per-user GPU budget at CLUSTER_QOS (running + pending)
CLUSTER_GRADE_MIRROR_ROOT=''                 # the grading host's local mirror of this cluster's stores (08_grade.sh store map)
