# reproduce/site.example/config.env — the site config. Copy this directory to $SISTEER_SITE_DIR (default
# ~/.config/sisteer), edit the values, and every stage script reads it (`--config <file>` overrides the location).
# Nothing personal lives in the repo: the shipped example uses neutral labels (cluster_a / cluster_b) and placeholder
# paths. Every key below has a default or a loud refusal; a value written as '$SHARED/…' is expanded per cluster.
# A value may hold the site placeholders below and no other `$`: an environment variable such as $HOME or $USER, a
# misspelt $SHARE and a bare `$` refuse by name when the file is read (write the path out, `~` for the home directory).

# --- storage / clusters -------------------------------------------------------------------------------------------------
SISTEER_CLUSTERS="cluster_a cluster_b"       # site labels the stages fan out to by default; one file per label under clusters/<label>.env.
                                             # A block under clusters/ that this list leaves out is still reached by name (its site or registry label)
SISTEER_PRIMARY_CLUSTER=cluster_a            # all else equal, the first submission goes here
SISTEER_DATA_ROOT='$SHARED/exp/corpora'      # materialised corpora finals + the reference tokenizers (stage 02)
SISTEER_LOG_DIR='$SHARED/exp/logs'
SISTEER_FIG_DIR='$SHARED/exp/figs'
SISTEER_WAVE_ROOT='$SHARED/exp/sdfbase_full22_native'
SISTEER_REPRODUCE_ROOT='$SHARED/exp/reproduce'   # front-door state on the cluster: <root>/<model>/{attempts,waves,watch,gate}
SISTEER_TIME_FIT=2-00:00:00
SISTEER_TIME_HPO=12:00:00
SISTEER_TIME_EVAL=1-00:00:00
SISTEER_TIME_PETRI=1-00:00:00                 # the Petri proxy's --time (06, first and overflow passes; SISTEER_TIME_EVAL does not reach it): a day, as the paper ran every proxy — the proxy frees its GPU when the drive ends, so the day is a ceiling, not a cost
SISTEER_TIME_PROBE=04:00:00
SISTEER_TIME_RECON=03:00:00                  # 03_hpo.sh --phase recon: ONE ladder rung's walltime (the ladder is an array, one rung per task); 150 optimizer steps at the fits' effective batch — size it from the model's pace (the paper models' rungs take minutes; a large model may need 12:00:00)
SISTEER_HPO_RECON_CELL=constv2ctl2-full      # the cell the reconnaissance rungs train on — the paper's (17,073 rows: 150 steps in ONE pass at effective batch 64); a cell short of 150 steps per pass refuses
# SISTEER_HPO_RECON_ALLOW_CYCLING=1            # opt-in ONLY: let a short cell be cycled to 150 steps (a methodological change, recorded as cycled_passes); default off

# --- placeholders in committed configs ----------------------------------------------------------------------------------
# Committed configs write site paths as placeholders and expand them when a script reads the value (src/sisteer/site.py):
# $SHARED and $HF_HOME come from the cluster block (CLUSTER_SHARED_ROOT, CLUSTER_HF_HOME) or a job's environment, and
# $WANDB_PROJECT from WANDB_PROJECT or SISTEER_WANDB_PROJECT (below). The keys here give the other five; ${NAME} is the
# same as $NAME. A config whose placeholder has no value on this host refuses by name and nothing is read or written.
SISTEER_STATE_ROOT='~/.local/state'           # $STATE: the per-user state root (attack-pool stores and similar); not SISTEER_STATE_DIR, the front door's own state directory
SISTEER_RUN_STATE_ROOT='~/.local/state/sisteer-runs'   # $RUNSTATE: the per-user run-state tree the experiment lanes write (ledgers, mirrors, lane run state)
SISTEER_STAGE_DIR='~/sisteer-stage'           # $STAGE: the grading host's staging directory for fitted objects
SISTEER_WORK_DIR='~/sisteer-work'             # $WORK: the grading host's working-data root (sampler stores and similar)
SISTEER_GRADE_DIR='~/sisteer-grade'           # $GRADE: the grading host's grade root
# SISTEER_JAILBREAK_PRIVATE_ROOT=''           # the grading host's private jailbreak root (default $STATE/sisteer-jailbreak)
# SISTEER_ATTACKER_POOL_STATE_DIR=''          # the Modal attacker pools' local records (default $STATE/sisteer/attacker-pool-modal)
# SISTEER_PYTEST_LOCK=''                      # the grading host's shared pytest lock (default $STATE/sisteer-pytest/lock)

# --- secrets (three modes, never a fourth; docs/secrets.md) -------------------------------------------------------------
SISTEER_SECRETS_MODE=env                     # env: plain variables | op: a secret-manager CLI wrapper (items below) | wif: workload identity federation
# env mode reads: ANTHROPIC_API_KEY (ONE key serves every credential label), OPENROUTER_API_KEY, MODAL_TOKEN_ID, MODAL_TOKEN_SECRET,
#                 HF_TOKEN (optional), WANDB_API_KEY (optional)
# wif mode (a GCP VM whose attached service account is federated with the Anthropic API): the judges authenticate
#                 through workload identity federation — NO Anthropic API key exists or is read (ANTHROPIC_API_KEY* stay
#                 unset); each credential label's federation ids are read from its own KEY=VALUE file under SISTEER_WIF_ENV_DIR
#                 (default ~/.anthropic; sisteer.vault.WIF_ORG_FILES names each label's file), and every judge's
#                 provenance records {pool, auth: wif, ids_sha12} instead of a key digest. The other secrets (OpenRouter,
#                 Modal, HF, W&B) resolve as under op, through the items below.
# op mode runs the secret-manager CLI SISTEER_SECRET_CMD names (an executable, as a path or a name on PATH, that takes one
#                 item name and prints its value; there is no default) for each credential, with these item names (one per credential
#                 label; lowprio, highprio and batch are labels, map each to any key or all to one):
# SISTEER_SECRET_CMD=/path/to/secret-cli      # op mode, and wif mode for the secrets above
SISTEER_OP_ITEM_ANTHROPIC_LOWPRIO=lowprio
SISTEER_OP_ITEM_ANTHROPIC_HIGHPRIO=highprio
SISTEER_OP_ITEM_ANTHROPIC_BATCH=batch
SISTEER_OP_ITEM_OPENROUTER="OpenRouter API Key"
SISTEER_OP_ITEM_HF=HF
SISTEER_OP_ITEM_HF_CLUSTER_READ="HF cluster read"
SISTEER_OP_ITEM_WANDB="Weights and Biases"

# --- Modal (BigCodeBench / BFCL only) -----------------------------------------------------------------------------------
SISTEER_MODAL_VOLUME=twosi-fits
SISTEER_MODAL_ENVIRONMENT=main
SISTEER_MODAL_PYTHON=modal                    # the `modal` CLI (or /path/to/venv/bin/python -m modal)

# --- registry ----------------------------------------------------------------------------------------------------------
SISTEER_REGISTRY_ROOT=~/registry              # the grading host's registry (registry.sqlite, records/, inbox/, state/)
SISTEER_REGISTRY_SPOOL=''                     # empty -> the emitter's resolution order ($SHARED/registry/records on a cluster)
SISTEER_GRADING_HOST=local                    # `local` (this machine runs the judges) or an ssh alias
SISTEER_UNIT_ENV_HOOK=''                      # optional: a command printing shell `export` lines (a secret-manager wrapper, say) that the
                                              # registry's gate-baseline timer evaluates before it reads a private git origin; empty -> none
# SISTEER_REPO=~/constitutional-adapters      # the checkout the registry's timers run (default: the checkout whose installer renders them)
# SISTEER_SLURM_SUBSTRATES="<slurm cluster name>=<registry label>[@<absolute shared root>] ..."
                                              # optional: maps each cluster's Slurm ClusterName to its registry label (CLUSTER_SUBSTRATE),
                                              # so a job's records name the cluster they ran on; entries are separated by spaces or commas
# SISTEER_REGISTRY_CAMPAIGN=sdfbase_full22    # the registry campaign this site's objects and runs are filed under AND read back under — 03/04's fits
                                              # (REGISTRY_CAMPAIGN in every job env), 08's daemon, and the pins writer make_full22_configs.py (05's
                                              # --pins-from and the fit-your-own --derived-pins-from-registry read the rows where 04 registered them);
                                              # default the paper frame's sdfbase_full22 — name another only to keep a site's rows apart from the paper's
SISTEER_OBJECTS_BANK=''                       # the grading host's objects bank: 05_stage_roster.sh stages the model's objects here (--bank's default),
                                              # the Petri drive reads its bank view under it (08 -> grade_daemon --petri-bank-root) and 09_dose_ladder.sh builds
                                              # the dose copies in it from the parents 05 staged (build_strength.py --parent-root); empty -> $SISTEER_STATE_DIR/objects
                                              # (the singular SISTEER_OBJECT_BANK is not a key and refuses by name)

# --- optional -----------------------------------------------------------------------------------------------------------
SISTEER_WANDB_ENTITY=''                       # both set -> W&B on (WANDB_MODE=offline on clusters); else off
SISTEER_WANDB_PROJECT=''                      # also what $WANDB_PROJECT in a committed config expands to when WANDB_PROJECT is unset
# SISTEER_WANDB_PROJECT_<PURPOSE>=            # per-purpose override, checked before WANDB_PROJECT (tinycap, seedrep, distill, judged,
                                              # serving-timing, multilora-cert, fits = new generated fit configs; default sisteer-<purpose>)
                                              # budget and alphasteer (hand-submitted cluster jobs) reach the compute nodes through
                                              # 00_setup.sh --what helpers (hf_site.env): re-run it after changing them; unset there,
                                              # budget logs to sisteer-budget and alphasteer leaves W&B off
SISTEER_MODAL_WANDB_SECRET=''                 # the Modal secret the fit apps mount for W&B (WANDB_API_KEY + WANDB_ENTITY + WANDB_PROJECT); read from here or the environment where they are deployed; needed with W&B on
SISTEER_PYTHON=''                             # the interpreter for the front door's helpers (default: <repo>/.venv/bin/python, else python3)
SISTEER_FIT_ENV_NAME=''                       # the prebuilt fit venv's name on every cluster (default sdfbase-fit); a cluster block's CLUSTER_FIT_ENV_NAME wins for that cluster
SISTEER_COORDINATION_CHANNEL=''               # a chat channel where the site coordinates concurrent API use: API runs print a ready-to-post line for it; empty -> none

# --- eval geometry -------------------------------------------------------------------------------------------------------
SISTEER_ATTACKER_MODEL=huihui-ai/Huihui-Qwen3.6-27B-abliterated
SISTEER_ATTACKER_REVISION=27502c8717fd5a2f8c0c77188c10c243fd4f672e
SISTEER_MT_ATTACKER_GPUS=4                    # attacker pool members per active cluster
SISTEER_MT_TARGET_GPUS=12                     # one-GPU target units per active cluster (3 attacks x 4 shard groups)
SISTEER_MT_ALLOCATION_GPUS=16
SISTEER_SHARD_GROUPS="0,1,2 3,4 5,6 7,8"      # the four disjoint shard groups over the 9 shards
SISTEER_DUAL_SUBMIT_THRESHOLD_MIN=10          # twin to the other cluster after this long PENDING …
SISTEER_DUAL_SUBMIT_MAX_JOBS=16               # … when fewer than this many units are left to place
SISTEER_GRANT_TIMEOUT_MIN=10                  # an attempt waiting on its start grant leaves after this

# --- run overrides (optional) -------------------------------------------------------------------------------------------
SISTEER_RUN_OVERRIDES=''                      # a reproduce/overrides/*.env; empty -> paper_defaults.env; recorded on every row
