# reproduce/overrides/demo_smoke.env — the worked example's SMOKE recipe: every knob at the paper's value (paper_defaults.env,
# verbatim) plus the ONE smoke knob the planner reads, OVERRIDE_SMOKE_GOALS. Select it with `--overrides reproduce/overrides/demo_smoke.env`
# on stages 05 (freeze) and 06, or SISTEER_RUN_OVERRIDES in config.env. Every registry row a smoke produces is stamped
# run_overrides.id = demo_smoke, which is how a smoke row is told from a paper-defaults row for ever after.
# OVERRIDE_MODEL names the ONE model this document is for: reproduce/lib/stage.py reads the smoke knob under this scoping (another
# --model refuses). The id, the model and the knob stand on comment-free lines: the registry's stamp reads them verbatim.
OVERRIDE_ID=demo_smoke
OVERRIDE_MODEL=qwen35_4b_demo
OVERRIDE_INIT_SCHEME=zero                    # LoRA B = 0; ReLU steer v = w = 0, gate bias b = 1 (the paper's Methods)
OVERRIDE_LORA_ARCH_SEARCH=0                  # rank 4 / o_proj on every model (the paper's LoRA architecture)
OVERRIDE_LORA_RANK=4
OVERRIDE_LORA_MODULE_SET=wo
OVERRIDE_HPO_WARMUP_FRAC=''                  # empty = the paper's two-level warm-up search {0.05, 0.15}
OVERRIDE_HPO_CLIP_MODE=searched              # the paper searched the clip (searched + empty warm-up = 03_hpo.sh's `paper` protocol)
OVERRIDE_HPO_CLIP_PERCENTILE=''
OVERRIDE_HPO_TRIALS=16
OVERRIDE_HPO_RECENTRE_TRIALS=4
OVERRIDE_REFUSAL_STEER_ALPHA=0.3             # the refusal steer's operating dose (the paper's; its ladder {0.15, 0.3, 0.5} is not run here)
OVERRIDE_EFFECTIVE_BATCH=64
# The smoke knob, `<lo>-<hi>/N`: the multi-turn targets run shards lo..hi of N (the driver slices goals[s::N] per attack, so 0-0/99 is
# goals [0::99], 3 of 259) and the per-view padding levels run the same range (target_static_padded_obj.sbatch `shards=<lo>-<hi>/N`;
# N <= 99, the store's shard00..shard99 names). Static, controls, mmlu, gsm8k, the BoN store and climb, agentic and Petri run whole.
# The planner reads it from THIS document (never the bare environment), pins it in the frozen inventory's header (plan_knobs), and
# refuses a plan whose live value differs from the pinned one; the producer key bakes sh<shards>of<nshards>, so a smoke and a
# confirmatory run are different data by construction.
OVERRIDE_SMOKE_GOALS=0-0/99
