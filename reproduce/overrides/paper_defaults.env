# reproduce/overrides/paper_defaults.env — the EMPTY overrides file: every knob at the paper's value (FD 18). What a
# stage sources when SISTEER_RUN_OVERRIDES is unset; recorded on every registry row as run_overrides.id = paper_defaults.
OVERRIDE_ID=paper_defaults
OVERRIDE_INIT_SCHEME=zero                    # LoRA B = 0; ReLU steer v = w = 0, gate bias b = 1 (the paper's Methods)
OVERRIDE_LORA_ARCH_SEARCH=0                  # rank 4 / o_proj on every model (the paper's LoRA architecture)
OVERRIDE_LORA_RANK=4
OVERRIDE_LORA_MODULE_SET=wo
OVERRIDE_HPO_WARMUP_FRAC=''                  # empty = the paper's two-level warm-up search {0.05, 0.15}
OVERRIDE_HPO_CLIP_MODE=searched              # the paper searched the clip
OVERRIDE_HPO_CLIP_PERCENTILE=''
OVERRIDE_HPO_TRIALS=16
OVERRIDE_HPO_RECENTRE_TRIALS=4
OVERRIDE_REFUSAL_STEER_ALPHA=0.3             # the refusal steer's operating dose (the paper's; its ladder {0.15, 0.3, 0.5} is not run here)
OVERRIDE_EFFECTIVE_BATCH=64
