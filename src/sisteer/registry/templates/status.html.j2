{% if rc.error %}<p class="note late"><strong>{{ rc.error }}</strong></p>{% endif %}
{% if rc.n_unreadable %}<p class="note late"><strong>{{ rc.n_unreadable }} receipt file(s) unreadable</strong> under <code>{{ slurm_only.reads_dir }}/receipts/</code>.</p>{% endif %}
