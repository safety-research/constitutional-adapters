# tests/fixtures/front_door/fd6_overrides.env — a SYNTHETIC run-overrides file for the front-door tests: the FD 6 protocol's knobs
# (the LoRA rank x module-set architecture search, whose serving probe the tests exercise) and no model-scoped ruling, so any model
# under test may load it (reproduce/lib/common.sh repro_load_overrides; reproduce/03_hpo.sh derives protocol fd6 from it). Never a
# run's record: the paper's values live in reproduce/overrides/paper_defaults.env.
OVERRIDE_ID=fd6_front_door_test
OVERRIDE_INIT_SCHEME=random_lecun_1e-3       # LoRA B ~ N(0, σ²), σ = 1e-3/√r (FD 7)
OVERRIDE_LORA_ARCH_SEARCH=1                  # log lr x rank {4,16,64} x module set {wo, qkvo, attn_mlp, mlp, down} (FD 6)
OVERRIDE_LORA_RANK=''                        # the pick comes from the published table (FD 6a) — models.yaml lora_architecture
OVERRIDE_LORA_MODULE_SET=''
OVERRIDE_HPO_WARMUP_FRAC=0.15                # fixed (one level: the FD 6 protocol)
OVERRIDE_HPO_CLIP_MODE=reconnaissance        # the clip from a reconnaissance run
OVERRIDE_HPO_CLIP_PERCENTILE=95
OVERRIDE_HPO_TRIALS=16
OVERRIDE_HPO_RECENTRE_TRIALS=4               # 3 refine + 1 exact confirmation
OVERRIDE_REFUSAL_STEER_ALPHA=0.3
OVERRIDE_EFFECTIVE_BATCH=64
